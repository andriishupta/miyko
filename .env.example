# Development values only. Copy to .env and replace passwords when needed.
POSTGRES_PASSWORD=dev-postgres-password
API_ROLE_PASSWORD=dev-api-role-password
HOST=127.0.0.1

# Runtime API connection: RLS-enabled, non-owner role.
DATABASE_URL=postgresql://api_role:dev-api-role-password@127.0.0.1:5432/miyko
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Drizzle migrations and demo seed: admin connection, never expose to the API client.
MIGRATION_DATABASE_URL=postgresql://postgres:dev-postgres-password@127.0.0.1:5432/miyko
DEMO_PASSWORD=miyko-demo-password

# Local workflow server. LANGGRAPH_API_KEY is only needed for a hosted deployment.
LANGGRAPH_API_URL=http://127.0.0.1:2024
# LANGGRAPH_API_KEY=replace-me
# MEM0_API_KEY=replace-me

# Provider OAuth remains server-side. Generate a 32-byte key as hex or base64.
PROVIDER_SECRETS_ENCRYPTION_KEY=
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
SILPO_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/providers/oauth/callback
PROVIDER_OAUTH_APP_REDIRECT_URI=miyko://provider/oauth/callback
