# Add these values to apps/workflows/.env. Never expose them to Expo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
MEM0_API_KEY=

# The API passes the household owner's OAuth access token as run-only context.
# Do not add provider credentials to this file or to LangGraph state.
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
